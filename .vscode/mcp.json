{
  "servers": {
    "azure": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@azure/mcp@latest", "server", "start"]
    },
    "terraform": {
      "type": "stdio",
      "command": "terraform-mcp-server",
      "args": ["-transport", "stdio"],
      "env": {
        "TFE_TOKEN": "${input:tfe_token}",
        "TFE_ADDRESS": "${input:tfe_address}"
      }
    },
    "drawio": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "drawio-mcp-server", "--editor"]
    }
  },
  "inputs": [
    {
      "type": "promptString",
      "id": "tfe_token",
      "description": "Terraform Cloud / Enterprise API token (leave blank for public registry only)",
      "password": true
    },
    {
      "type": "promptString",
      "id": "tfe_address",
      "description": "Terraform Enterprise address (leave blank for app.terraform.io)",
      "password": false
    }
  ]
}