{
  "servers": {
    "azure": {
      "type": "stdio",
      "command": "npx.cmd",
      "args": ["-y", "@azure/mcp@latest", "server", "start"]
    },
    "drawio": {
      "type": "stdio",
      "command": "npx.cmd",
      "args": ["-y", "drawio-mcp-server", "--editor"]
    }
  },
  "inputs": [
    {
      "type": "promptString",
      "id": "tfe_token",
      "description": "Terraform Cloud / Enterprise API token (leave blank for public registry only)",
      "password": true
    },
    {
      "type": "promptString",
      "id": "tfe_address",
      "description": "Terraform Enterprise address (leave blank for app.terraform.io)",
      "password": false
    }
  ]
}