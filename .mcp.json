{
  "mcpServers": {
    "azure": {
      "type": "stdio",
      "command": "npx.cmd",
      "args": [
        "-y",
        "@azure/mcp@latest",
        "server",
        "start"
      ]
    },
    "drawio": {
      "type": "stdio",
      "command": "npx.cmd",
      "args": [
        "-y",
        "drawio-mcp-server",
        "--editor"
      ]
    }
  }
}